{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioreport.local/schemas/rna-report.json",
  "title": "Quarto report configuration",
  "type": "object",
  "properties": {
    "report": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "single",
            "website"
          ]
        },
        "modules": {
          "$ref": "#/$defs/modules"
        },
        "sections": {
          "$ref": "#/$defs/modules"
        },
        "module_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object"
              },
              "required_inputs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "output_format": {
          "oneOf": [
            {
              "enum": [
                "html",
                "pdf"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "html",
                  "pdf"
                ]
              }
            }
          ]
        },
        "theme": {
          "type": "object",
          "properties": {
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          }
        },
        "css": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "navbar_right": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "announcement": {
          "type": [
            "object",
            "null"
          ]
        },
        "pdf": {
          "type": "object",
          "properties": {
            "sample_rows": {
              "type": "integer",
              "minimum": 1
            },
            "qc_rows": {
              "type": "integer",
              "minimum": 1
            },
            "matrix_rows": {
              "type": "integer",
              "minimum": 1
            },
            "matrix_columns": {
              "type": "integer",
              "minimum": 1
            },
            "deg_rows": {
              "type": "integer",
              "minimum": 1
            },
            "enrichment_rows": {
              "type": "integer",
              "minimum": 1
            },
            "enrichment_top_n": {
              "type": "integer",
              "minimum": 1
            },
            "qc_detail": {
              "enum": [
                "key",
                "all"
              ]
            },
            "fonts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mono_fonts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hvg_top_n": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "security": {
          "type": "object",
          "properties": {
            "enable_read_only_lock": {
              "type": "boolean"
            },
            "allow_copy_text": {
              "type": "boolean"
            },
            "allow_print": {
              "type": "boolean"
            },
            "owner_password": {
              "type": "string",
              "minLength": 1
            },
            "owner_password_env": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "genome_version": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "report_date": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "input_files": {
      "$ref": "#/$defs/paths"
    },
    "files": {
      "$ref": "#/$defs/paths"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "deg": {
          "type": "object",
          "properties": {
            "log2fc_threshold": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pvalue_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "enrichment": {
          "type": "object",
          "properties": {
            "p_cutoff": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "top_n": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "heatmap": {
          "type": "object",
          "properties": {
            "top_n": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pca": {
          "$ref": "#/$defs/dimensions"
        },
        "distribution": {
          "allOf": [
            {
              "$ref": "#/$defs/dimensions"
            },
            {
              "type": "object",
              "properties": {
                "threshold": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "expression": {
          "type": "object",
          "properties": {
            "preview_rows": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "volcengine",
            "aliyun"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "deg_limit": {
          "type": "integer",
          "minimum": 1
        },
        "enrichment_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 100
        },
        "height": {
          "type": "integer",
          "minimum": 100
        }
      }
    }
  }
}
