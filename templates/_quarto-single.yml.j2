project:
  type: default
  render:
    - qmd/report.qmd
    - qmd/report_pdf.qmd
  output-dir: {{ output_dir }}

format:
  html:
    embed-resources: true
    html-math-method: katex
    toc: true
    toc-depth: 3
    toc-location: left
    toc-title: Contents
    number-sections: true
    code-copy: true
    smooth-scroll: true
    df-print: paged
    include-in-header:
      - theme/report-pages.html
    include-after-body:
      - theme/load-mermaid.html
    theme:
      light: {{ (report.get('theme') or {}).get('light', 'theme/bioreport.scss') }}
      dark: {{ (report.get('theme') or {}).get('dark', 'darkly') if (report.get('theme') or {}).get('dark') != (report.get('theme') or {}).get('light') else 'darkly' }}
    css:
{% if staged_fonts %}
      - {{ staged_fonts }}
{% endif %}
{% for css_file in (report.get('css') or ['theme/styles.css', 'theme/itables_saas.css']) %}
      - {{ css_file }}
{% endfor %}
  typst:
    toc: true
    number-sections: true
