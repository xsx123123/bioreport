project:
  type: default
  render:
    - qmd/report.qmd
    - qmd/report_pdf.qmd
  output-dir: {{ output_dir }}

format:
  html:
    embed-resources: true
    html-math-method: katex
    self-contained-math: true
    toc: true
    toc-depth: 3
    toc-location: left
    page-layout: article
    grid:
      body-width: 1150px
      sidebar-width: 200px
      margin-width: 180px
      gutter-width: 1.2rem
    toc-title: Contents
    number-sections: true
    code-copy: true
    smooth-scroll: true
    df-print: paged
    include-in-header:
      - theme/report-pages.html
      - theme/comparisons-fold.html
    include-after-body:
      - theme/load-mermaid.html
{% if pet and pet.enabled %}
      - theme/report-pet.html
{% endif %}
    theme:
      light:
        - {{ (report.get('theme') or {}).get('light', 'theme/bioreport.scss') }}
        - theme/offline-fonts.scss
      dark:
        - {{ (report.get('theme') or {}).get('dark', 'darkly') if (report.get('theme') or {}).get('dark') != (report.get('theme') or {}).get('light') else 'darkly' }}
        - theme/offline-fonts.scss
    css:
{% if staged_fonts %}
      - {{ staged_fonts }}
{% endif %}
{% for css_file in (report.get('css') or ['theme/styles.css', 'theme/itables_saas.css']) %}
      - {{ css_file }}
{% endfor %}
  typst:
    toc: true
    number-sections: true
