project:
  type: website
  render:
{% for page in pages %}
    - {{ page.href }}
{% endfor %}
  output-dir: {{ output_dir | default('/workspace') }}

website:
  title: "{{ report.title | default('BFP Report') }}"
  reader-mode: true
  page-navigation: true
  navbar:
    logo: {{ report.logo | default('logo/logo.png') }}
    logo-href: "{{ report.logo_href | default('https://github.com/xsx123123') }}"
    pinned: true
    background: primary
    search: true
    left:
{% for page in pages %}
      - href: {{ page.href }}
        text: "{{ page.title }}"
{% endfor %}
{% if report.navbar_right %}
    right:
{% for item in report.navbar_right | default([]) %}
      - icon: {{ item.icon }}
        href: "{{ item.href }}"
{% endfor %}
{% endif %}
{% if report.announcement %}
    announcement:
      icon: {{ report.announcement.icon | default('info-circle') }}
      dismissable: {{ report.announcement.dismissable | default(true) | lower }}
      content: "{{ report.announcement.content | default('') }}"
      type: {{ report.announcement.type | default('primary') }}
      position: {{ report.announcement.position | default('below-navbar') }}
{% endif %}
  sidebar:
    title: "{{ report.sidebar_title | default('RNA-seq Report') }}"
    logo: {{ report.logo | default('logo/logo.png') }}
    logo-href: "{{ report.logo_href | default('https://github.com/xsx123123') }}"
    alignment: left
    style: "floating"
    pinned: true
    contents:
{% for page in pages %}
      - href: {{ page.href }}
        text: "{{ page.title }}"
{% endfor %}
    tools:
      - icon: twitter
        href: https://twitter.com
      - icon: github
        menu:
          - text: Source Code
            href: https://github.com/xsx123123/bioreport
          - text: Report a Bug
            href: https://github.com/xsx123123/bioreport/issues
  page-footer:
      border: true
      left: |
        <img src="/logo/Huazhong_Agricultural_University_logo.svg" alt="华中农业大学" height="32" style="vertical-align: middle; margin-right: 10px;">
        <span style="vertical-align: middle;">FROM STARDUST, TO DISCOVERY</span>
        <a href="https://posit.co" target="_blank" style="text-decoration: none; border-bottom: none;">
          <img src="/logo/Posit_logo.svg" alt="Posit" height="18" style="vertical-align: middle; margin: 0 10px;">
        </a>
        &nbsp;
        <a href="https://github.com/xsx123123" target="_blank" class="footer-icon"><i class="bi bi-github"></i></a>
        &nbsp;


      center: |
{% for page in pages if page.title == '关于' %}
        <a href="/{{ page.href | replace('.qmd', '.html') }}" class="footer-link">关于 BioReport</a>
{% endfor %}

format:
  html:
    embed-resources: false
    self-contained: false
    theme:
      - {{ (report.get('theme') or {}).get('light', 'theme/New_Brutalism.scss') }}
    mainfont: "Public Sans"
    toc: true
    toc-depth: 3
    number-sections: false
    css:
{% for css_file in (report.get('css') or ['theme/styles.css', 'theme/itables_saas.css']) %}
      - {{ css_file }}
{% endfor %}
    grid:
      sidebar-width: 200px
      body-width: 1050px
      margin-width: 250px
      gutter-width: 1.2rem
    toc-location: right
    toc-title: "目录"
    page-layout: article
    code-copy: true
    smooth-scroll: true
    anchor-sections: true
    df-print: paged
    include-after-body:
      - ./theme/load-mermaid.html
    language:
      search-text-placeholder: Search
