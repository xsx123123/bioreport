project:
  type: website
  render:
{% for page in pages %}
    - {{ page.href }}
{% endfor %}
  output-dir: {{ output_dir | default('/workspace') }}

  resources:
    - fonts.css
    - fonts/**
    - assets/**
    - logo/**

website:
  title: BioReport
  navbar: false
  search: false

format:
  html:
    html-math-method: katex
    self-contained-math: true
    embed-resources: false
    self-contained: false
    theme:
      light:
        - {{ (report.get('theme') or {}).get('light', 'theme/bioreport.scss') }}
        - theme/offline-fonts.scss
      dark:
        - {{ (report.get('theme') or {}).get('dark', 'darkly') }}
        - theme/offline-fonts.scss
    mainfont: "Source Sans 3"
    toc: true
    toc-depth: 3
    number-sections: false
    css:
{% if staged_fonts %}
      - {{ staged_fonts }}
{% endif %}
{% for css_file in (report.get('css') or ['theme/styles.css', 'theme/itables_saas.css']) %}
      - {{ css_file }}
{% endfor %}
    grid:
      sidebar-width: 200px
      body-width: 1150px
      margin-width: 200px
      gutter-width: 1.2rem
    toc-location: right
    toc-title: "Contents"
    page-layout: article
    code-copy: true
    smooth-scroll: true
    anchor-sections: true
    df-print: paged
    include-in-header:
      - theme/report-pages.html
    include-after-body:
      - ./theme/load-mermaid.html
    language:
      search-text-placeholder: Search
