<style>
#bioreport-pet {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 1100;
  width: {{ pet.size }}px;
  height: {{ pet.height }}px;
  pointer-events: none;
  user-select: none;
}

#bioreport-pet .report-pet-button {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: grab;
  pointer-events: auto;
  touch-action: none;
}

#bioreport-pet .report-pet-button:active,
#bioreport-pet.is-dragging .report-pet-button {
  cursor: grabbing;
}

#bioreport-pet .report-pet-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  -webkit-user-drag: none;
  filter: drop-shadow(0 0.3rem 0.25rem rgba(15, 23, 42, .2));
  transition: filter .2s ease, transform .2s ease;
}

#bioreport-pet .report-pet-button:hover .report-pet-image,
#bioreport-pet .report-pet-button:focus-visible .report-pet-image {
  filter: drop-shadow(0 0.45rem 0.35rem rgba(15, 23, 42, .25));
  transform: translateY(-2px);
}

#bioreport-pet .report-pet-button:focus-visible {
  outline: 2px solid var(--br-primary, #2563eb);
  outline-offset: 3px;
  border-radius: 1rem;
}

@media (max-width: 700px) {
  #bioreport-pet {
    right: .35rem;
    bottom: .35rem;
    transform: scale(.78);
    transform-origin: bottom right;
  }
}

@media print {
  #bioreport-pet { display: none !important; }
}
</style>

<div id="bioreport-pet" aria-label="{{ pet.name }}" role="group">
  <button class="report-pet-button" type="button" aria-label="与{{ pet.name }}互动" title="点击互动，拖动调整位置">
    <img class="report-pet-image" src="{{ pet.assets.idle }}" alt="{{ pet.name }}" draggable="false">
  </button>
</div>

<script>
(() => {
  const root = document.getElementById('bioreport-pet');
  const button = root?.querySelector('.report-pet-button');
  const image = root?.querySelector('.report-pet-image');
  if (!root || !button || !image) return;

  const assets = {{ pet.assets | tojson }};
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let activityTimer;
  let returnTimer;
  let drag;
  let suppressClick = false;

  function clampPosition() {
    if (!root.style.left || !root.style.top) return;
    const bounds = root.getBoundingClientRect();
    root.style.left = `${Math.max(0, Math.min(window.innerWidth - bounds.width, bounds.left))}px`;
    root.style.top = `${Math.max(0, Math.min(window.innerHeight - bounds.height, bounds.top))}px`;
  }

  function setState(state, duration = 0) {
    image.src = reducedMotion.matches ? assets.still : (assets[state] || assets.idle);
    root.dataset.petState = state;
    window.clearTimeout(returnTimer);
    if (duration) returnTimer = window.setTimeout(() => setState('idle'), duration);
  }

  function scheduleActivity() {
    window.clearTimeout(activityTimer);
    activityTimer = window.setTimeout(() => {
      if (!drag) {
        const states = ['waiting', 'waving', 'jumping'];
        setState(states[Math.floor(Math.random() * states.length)], 900);
      }
      scheduleActivity();
    }, 12000 + Math.random() * 10000);
  }

  button.addEventListener('click', () => {
    if (suppressClick) {
      suppressClick = false;
      return;
    }
    setState('jumping', 900);
    scheduleActivity();
  });

  button.addEventListener('dblclick', event => {
    event.preventDefault();
    setState('waving', 1200);
    scheduleActivity();
  });

  root.addEventListener('pointerdown', event => {
    if (event.button !== 0) return;
    const bounds = root.getBoundingClientRect();
    drag = {
      pointerId: event.pointerId,
      startX: event.clientX,
      startY: event.clientY,
      left: bounds.left,
      top: bounds.top,
      moved: false,
    };
  });

  root.addEventListener('pointermove', event => {
    if (!drag || drag.pointerId !== event.pointerId) return;
    const deltaX = event.clientX - drag.startX;
    const deltaY = event.clientY - drag.startY;
    if (!drag.moved && Math.hypot(deltaX, deltaY) < 6) return;
    drag.moved = true;
    if (!root.hasPointerCapture?.(event.pointerId)) root.setPointerCapture(event.pointerId);
    root.classList.add('is-dragging');
    root.style.left = `${Math.max(0, Math.min(window.innerWidth - root.offsetWidth, drag.left + deltaX))}px`;
    root.style.top = `${Math.max(0, Math.min(window.innerHeight - root.offsetHeight, drag.top + deltaY))}px`;
    root.style.right = 'auto';
    root.style.bottom = 'auto';
  });

  root.addEventListener('pointerup', event => {
    if (!drag || drag.pointerId !== event.pointerId) return;
    if (drag.moved) suppressClick = true;
    if (root.hasPointerCapture?.(event.pointerId)) root.releasePointerCapture(event.pointerId);
    root.classList.remove('is-dragging');
    drag = undefined;
    scheduleActivity();
  });

  root.addEventListener('pointercancel', () => {
    root.classList.remove('is-dragging');
    drag = undefined;
    scheduleActivity();
  });

  window.addEventListener('resize', clampPosition, {passive: true});
  const motionChanged = () => setState(root.dataset.petState || 'idle');
  if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', motionChanged);
  else reducedMotion.addListener?.(motionChanged);
  setState('idle');
  scheduleActivity();
})();
</script>
