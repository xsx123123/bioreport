flowchart TB
  Config["JSON / YAML 配置<br/>（JSON Schema 校验）"] --> Control["CLI · 配置校验与流程编排"]
  RNA["RNA-seq 模块 · omics/rna"] --> Compose["模块注册、选择与内容组合"]
  Custom["自定义 QMD 模块"] --> Compose
  Theme["Jinja2 模板与共享主题"] --> Stage["临时 Quarto 项目<br/>QMD / 配置 / 资源"]
  Control --> Compose --> Stage
  Data["已有分析结果与项目元数据"] --> Analysis["读取结果 · 统计汇总与绘图函数"]
  Stage --> Execute["Quarto / Jupyter · 执行所选模块"]
  Data --> Execute
  Execute --> Analysis

  Analysis --> HTMLView["HTML · Plotly / ITables"] --> HTML["单文件 HTML / 多页 HTML"]
  Analysis --> PDFView["PDF 图表 · 静态 SVG 与 Typst"]
  PDFView --> FirstPDF["PDF 第一次渲染<br/>生成图表与 block manifest"]
  FirstPDF --> Evidence["结构化证据 + 已渲染图像"]

  Control -.-> AIPre["AI 结果解读（HTML / 非视觉路径）"]
  Data -.-> AIPre
  AIPre -.-> Markdown["逐结果 Markdown 卡片"]
  Markdown -.-> Stage
  Evidence -.-> AIPost["AI 视觉解读（PDF 两阶段路径）"]
  AIPost -.-> Markdown
  Markdown -.-> SecondPDF["PDF 第二次渲染<br/>回填对应结果卡片"]
  SecondPDF --> PDF["PDF 报告 + 版式校验"]

  Control --> Records["运行日志 / 配置备份 / manifests"]
  Evidence -.-> Records
  AIPost -.-> Records

  classDef plain fill:#ffffff,stroke:#94a3b8,color:#334155;
  classDef blue fill:#eff6ff,stroke:#3b82f6,color:#173258;
  classDef green fill:#f0fdf4,stroke:#22a06b,color:#14532d;
  classDef optional fill:#faf5ff,stroke:#a78bfa,color:#553285;

  class Config,Data,RNA,Custom,Theme,HTMLView,PDFView plain;
  class Control,Compose,Stage,Execute,Analysis blue;
  class HTML,PDF,Records,FirstPDF,SecondPDF green;
  class AIPre,AIPost,Markdown,Evidence optional;
