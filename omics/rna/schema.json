{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioreport.dev/schema/omics/rna.json",
  "title": "RNA-seq analysis parameters",
  "type": "object",
  "properties": {
    "deg": {
      "type": "object",
      "properties": {
        "log2fc_threshold": {
          "type": "number"
        },
        "pvalue_threshold": {
          "type": "number"
        }
      }
    },
    "depth": {
      "type": "object",
      "properties": {
        "ratio_cutoff": {"type": "number", "exclusiveMinimum": 1}
      }
    },
    "qc_reference": {
      "type": "object",
      "properties": {
        "q30_min": {"type": "number", "minimum": 0, "maximum": 100},
        "mapping_min": {"type": "number", "minimum": 0, "maximum": 100},
        "duplication_max": {"type": "number", "minimum": 0, "maximum": 100},
        "retained_min": {"type": "number", "minimum": 0, "maximum": 100},
        "unique_min": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "p_cutoff": {
          "type": "number"
        },
        "top_n": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "volcano": {
      "type": "object",
      "properties": {
        "y_axis": {
          "type": "object",
          "properties": {
            "display_cap": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "fastq_screen": {
      "type": "object",
      "properties": {
        "legend": {
          "type": "object",
          "properties": {
            "min_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_categories": {
              "type": "integer",
              "minimum": 2
            },
            "aggregate_other": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
