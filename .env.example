# Optional local Workspace settings. Never commit real credentials.
BIOREPORT_DB=/path/to/runs.db
BIOREPORT_TRUSTED_ROOT=/path/to/report/root
BIOREPORT_API_TOKEN=
# Optional team-deployment controls; comma-separated exact project IDs.
BIOREPORT_ALLOWED_PROJECTS=
BIOREPORT_RATE_LIMIT_PER_MINUTE=120
BIOREPORT_CORS_ORIGINS=
# Provider keys stay on the API/CLI host and are never sent to the browser.
ARK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# Optional default endpoint for provider: openai-compatible
OPENAI_BASE_URL=
